  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "public/**"
  ],
  "rules": {
    "strictContext": true,
    "maxFilesPerPrompt": 3
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/Asus/OneDrive/Documentos/Mis programas/blucotravel/bluco-web"
      ]
    },
    
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}